@{
    ViewData["Title"] = "File Management System";
}

<div class="container">
    <h2>File Management System</h2>

    <!-- Action Buttons -->
    <div class="row mb-4">
        <div class="col-12">
            <button id="addFileBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#fileModal">
                <i class="fas fa-plus"></i> Add New File
            </button>
            <button id="refreshBtn" class="btn btn-secondary">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Files Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Uploaded Files</h5>
        </div>
        <div class="card-body">
            <div id="message" class="alert" style="display: none;"></div>
            <table class="table table-striped table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th>Name</th>
                        <th>Extension</th>
                        <th>Created Date</th>
                        <th>Size</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="filesTableBody">
                    <!-- Files will be loaded here via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add/Edit File Modal -->
<div class="modal fade" id="fileModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add New File</h5>
                <button type="button" class="close" data-bs-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="fileForm">
                    <input type="hidden" id="fileId">

                    <div class="form-group">
                        <label for="fileName">File Name:</label>
                        <input type="text" class="form-control" id="fileName" required>
                    </div>

                    <div class="form-group">
                        <label for="fileExtension">File Type:</label>
                        <select class="form-control mb-2" id="fileExtension" required >
                            <option value="">Select File Type</option>
                            <option value="txt">Text File (.txt)</option>
                            <option value="pdf">PDF Document (.pdf)</option>
                            <option value="docx">Word Document (.docx)</option>
                            <option value="xlsx">Excel Spreadsheet (.xlsx)</option>
                            <option value="jpg">JPEG Image (.jpg)</option>
                            <option value="png">PNG Image (.png)</option>
                            <option value="zip">ZIP Archive (.zip)</option>
                        </select>
                    </div>

                    <!-- Mode selection: Upload file OR Create from content -->
                    <div class="form-group mb-3">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="fileMode" id="modeUpload" value="upload" checked>
                            <label class="form-check-label" for="modeUpload">Upload Existing File</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="fileMode" id="modeContent" value="content">
                            <label class="form-check-label" for="modeContent">Create From Content</label>
                        </div>
                    </div>

                    <div class="form-group" id="fileUploadGroup">
                        <label for="fileInput">Select File:</label>
                        <input type="file" class="form-control-file" id="fileInput">
                    </div>

                    <div class="form-group" id="fileContentGroup" style="display:none;">
                        <label for="fileContent">Content:</label>
                        <textarea class="form-control" id="fileContent" rows="6" placeholder="Enter file content here..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveFileBtn">Save File</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Files/Files_Ajax.js"></script>
}