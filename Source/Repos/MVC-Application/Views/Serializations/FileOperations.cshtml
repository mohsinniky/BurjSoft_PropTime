
@{
    ViewData["Title"] = "FileOperations";
}

<h1>FileOperations</h1>
<div class="container">
    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div class="alert alert-info">
            @ViewBag.Message
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <h4>Create a File</h4>
            <form method="post" asp-action="CreateFile">
                <div class="form-group">
                    <label for="fileName">File Name:</label>
                    <input type="text" class="form-control" id="fileName" name="fileName" placeholder="e.g., test.txt" required>
                </div>
                <div class="form-group">
                    <label for="content">Content:</label>
                    <textarea class="form-control" id="content" name="content" rows="3" placeholder="Enter file content"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Create File</button>
            </form>
        </div>

        <div class="col-md-6">
            <h4>Read a File</h4>
            <form method="post" asp-action="ReadFile">
                <div class="form-group">
                    <label for="readFileName">File Name:</label>
                    <input type="text" class="form-control" id="readFileName" name="fileName" placeholder="e.g., test.txt" required>
                </div>
                <button type="submit" class="btn btn-success">Read File</button>
            </form>

            @if (ViewBag.FileContent != null)
            {
                <div class="mt-3">
                    <h5>File Content:</h5>
                    <div class="alert alert-secondary">
                        <pre>@ViewBag.FileContent</pre>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <form method="get" asp-action="ListFiles">
                <button type="submit" class="btn btn-info">List All Files</button>
            </form>

            @if (ViewBag.Files != null)
            {
                <div class="mt-3">
                    <h5>Available Files:</h5>
                    <ul class="list-group">
                        @foreach (var file in ViewBag.Files)
                        {
                            <li class="list-group-item">@file</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
