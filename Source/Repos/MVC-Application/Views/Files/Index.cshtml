@{
    ViewData["Title"] = "File Manager";
}

<div class="container">
    <h2>File Manager</h2>

    <div class="row mb-4">
        <div class="col-12">
            <button id="addFileBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#fileModal">
                <i class="fas fa-plus"></i> New File
            </button>
            <button id="uploadFileBtn" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#uploadModal">
                <i class="fas fa-upload"></i> Upload File
            </button>
            <button id="refreshBtn" class="btn btn-secondary">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Files</h5>
        </div>
        <div class="card-body">
            <div id="message" class="alert" style="display: none;"></div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Created Date</th>
                        <th>Size</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="filesTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create/Edit File Modal -->
<div class="modal fade" id="fileModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">New File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="fileForm">
                    <input type="hidden" id="fileId">

                    <div class="mb-3">
                        <label for="fileName" class="form-label">File Name:</label>
                        <input type="text" class="form-control" id="fileName" required>
                    </div>

                    <div class="mb-3">
                        <label for="fileExtension" class="form-label">File Type:</label>
                        <select class="form-control" id="fileExtension">
                            <option value=".txt">Text File (.txt)</option>
                            <option value=".pdf">PDF Document (.pdf)</option>
                            <option value=".doc">Word Document (.doc)</option>
                            <option value=".docx">Word Document (.docx)</option>
                            <option value=".xls">Excel Spreadsheet (.xls)</option>
                            <option value=".xlsx">Excel Spreadsheet (.xlsx)</option>
                            <option value=".jpg">JPEG Image (.jpg)</option>
                            <option value=".jpeg">JPEG Image (.jpeg)</option>
                            <option value=".png">PNG Image (.png)</option>
                            <option value=".gif">GIF Image (.gif)</option>
                            <option value=".zip">ZIP Archive (.zip)</option>
                            <option value=".rar">RAR Archive (.rar)</option>
                        </select>
                        <div class="form-text">Select the file type. Only text files can be edited directly.</div>
                    </div>

                    <div class="mb-3" id="contentSection">
                        <label for="fileContent" class="form-label">Content:</label>
                        <textarea class="form-control" id="fileContent" rows="10" placeholder="Enter file content..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveFileBtn">Create File</button>
            </div>
        </div>
    </div>
</div>

<!-- Upload File Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="uploadForm">
                    <div class="mb-3">
                        <label for="uploadInput" class="form-label">Select file:</label>
                        <input type="file" class="form-control" id="uploadInput"
                               accept=".txt,.pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.zip,.rar" required>
                        <div class="form-text">Allowed types: .txt, .pdf, .doc, .docx, .xls, .xlsx, .jpg, .jpeg, .png, .gif, .zip, .rar (Max: 10MB)</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="uploadBtn">Upload</button>
            </div>
        </div>
    </div>
</div>

<!-- Replace File Modal -->
<div class="modal fade" id="replaceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Replace File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="replaceForm">
                    <input type="hidden" id="replaceFileId">
                    <div class="mb-3">
                        <label for="replaceInput" class="form-label">Select replacement file:</label>
                        <input type="file" class="form-control" id="replaceInput" required>
                        <div class="form-text" id="replaceFileTypeInfo"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="replaceBtn">Replace</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/files/files_ajax.js"></script>
}