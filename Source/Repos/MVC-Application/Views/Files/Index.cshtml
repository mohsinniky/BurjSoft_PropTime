@{
    ViewData["Title"] = "Text File Manager";
}

<div class="container">
    <h2>Text File Manager</h2>

    <div class="row mb-4">
        <div class="col-12">
            <button id="addFileBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#fileModal">
                <i class="fas fa-plus"></i> New Text File
            </button>
            <button id="uploadFileBtn" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#uploadModal">
                <i class="fas fa-upload"></i> Upload Text File
            </button>
            <button id="refreshBtn" class="btn btn-secondary">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Text Files</h5>
        </div>
        <div class="card-body">
            <div id="message" class="alert" style="display: none;"></div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Created Date</th>
                        <th>Size</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="filesTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create/Edit File Modal -->
<div class="modal fade" id="fileModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">New Text File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="fileForm">
                    <input type="hidden" id="fileId">

                    <div class="mb-3">
                        <label for="fileName" class="form-label">File Name:</label>
                        <input type="text" class="form-control" id="fileName" required>
                    </div>

                    <div class="mb-3">
                        <label for="fileContent" class="form-label">Content:</label>
                        <textarea class="form-control" id="fileContent" rows="10" placeholder="Enter file content..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveFileBtn">Save File</button>
            </div>
        </div>
    </div>
</div>

<!-- Upload File Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Text File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="uploadForm">
                    <div class="mb-3">
                        <label for="uploadInput" class="form-label">Select .txt file:</label>
                        <input type="file" class="form-control" id="uploadInput" accept=".txt" required>
                        <div class="form-text">Only .txt files are allowed.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="uploadBtn">Upload</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/files/files_ajax.js"></script>
}