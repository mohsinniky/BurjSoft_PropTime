@model MVC_Application.ViewModels.StudentOperationsViewModel

@{
    ViewData["Title"] = "Students";
}

<div class="container">
    <h1>Students Management</h1>

    <div class="mb-3">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStudentModal">
            Add New Student
        </button>
    </div>

    <!-- Simplified Table -->
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>StudentId</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>@student.StudentId</td>
                        <td>@student.FullName</td>
                        <td>@student.Email</td>
                        <td>@student.PhoneNumber</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@student.StudentId" class="btn btn-info btn-sm">Details</a>
                            <a asp-action="Edit" asp-route-id="@student.StudentId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@student.StudentId" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Students.Any())
    {
        <div class="alert alert-info">
            No students found. Click "Add New Student" to create the first student.
        </div>
    }
</div>

<!-- Modal remains exactly the same -->
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createStudentForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="StudentForm_Student_FirstName" class="form-label">First Name</label>
                                <input type="text" class="form-control" id="StudentForm_Student_FirstName">
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="StudentForm_Student_LastName" class="form-label">Last Name</label>
                                <input type="text" class="form-control" id="StudentForm_Student_LastName">
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="StudentForm_Student_Email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="StudentForm_Student_Email">
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="StudentForm_Student_PhoneNumber" class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="StudentForm_Student_PhoneNumber">
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Select Courses</label>
                        <div>
                            @foreach (var course in Model.AvailableCourses)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedCourseIds" value="@course.CourseId" id="course_@course.CourseId">
                                    <label class="form-check-label" for="course_@course.CourseId">@course.CourseDisplay</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/studentcourse/studentcourse_ajax_validation.js"></script>
}