@using MVC_Application.DTOs
@model MVC_Application.ViewModels.StudentOperationsViewModel

@{
    ViewData["Title"] = "Students";
}

<div class="container">
    <h1>Students Management</h1>

    <div class="mb-3">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStudentModal">
            Add New Student
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Grade</th>
                    <th>Address</th>
                    <th>Courses</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr data-student-id="@student.StudentId">
                        <td>@student.StudentId</td>
                        <td>@student.FullName</td>
                        <td>@student.Email</td>
                        <td>@student.PhoneNumber</td>
                        <td>
                            @if (!string.IsNullOrEmpty(student.GradeName))
                            {
                                <span class="badge bg-info">@student.GradeName</span>
                            }
                            else
                            {
                                <span class="text-muted">No grade</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(student.StudentAddress.City))
                            {
                                <small>@student.StudentAddress.City, @student.StudentAddress.State</small>
                            }
                            else
                            {
                                <span class="text-muted">No address</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(student.CoursesDisplay))
                            {
                                <div class="courses-container" style="max-width: 200px;">
                                    @foreach (var course in student.CoursesDisplay.Split(", "))
                                    {
                                        <span class="badge bg-secondary me-1 mb-1">@course</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No courses</span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-info btn-sm"
                                    onclick="openDetailsModal(@student.StudentId)">
                                Details
                            </button>
                            <button type="button" class="btn btn-warning btn-sm"
                                    onclick="openEditModal(@student.StudentId)">
                                Edit
                            </button>
                            <button type="button" class="btn btn-danger btn-sm"
                                    onclick="deleteStudent(@student.StudentId, '@student.FullName')"
                                    data-student-id="@student.StudentId">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Students.Any())
    {
        <div class="alert alert-info">
            No students found. Click "Add New Student" to create the first student.
        </div>
    }
</div>

<!-- Simple Pagination with Page Numbers -->
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            <span class="text-muted">
                Page @Model.CurrentPage of @Model.TotalPages
                (@Model.TotalCount total students)
            </span>
        </div>

        <div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <!-- Previous Button -->
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize })">
                            &laquo;
                        </a>
                    </li>

                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <li class="page-item active">
                                <span class="page-link">@i</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize })">
                                    @i
                                </a>
                            </li>
                        }
                    }

                    <!-- Next Button -->
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize })">
                            &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}

<!-- Simple Page Size Selector -->
<div class="mt-2">
    <small class="text-muted">Show: </small>
    <select onchange="location = this.value;" class="form-select form-select-sm d-inline-block w-auto">
        <option value="@Url.Action("Index", new { page = 1, pageSize = 1 })"
                selected="@(Model.PageSize == 1)">1</option>
        <option value="@Url.Action("Index", new { page = 1, pageSize = 2 })"
                selected="@(Model.PageSize == 2)">2</option>
        <option value="@Url.Action("Index", new { page = 1, pageSize = 3 })"
                selected="@(Model.PageSize == 3)">3</option>
    </select>
    <small class="text-muted">per page</small>
</div>



<!-- Fixed Modal with Footer -->
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add New Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createStudentForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="FirstName" class="form-label">First Name</label>
                                <input type="text" class="form-control" id="FirstName" name="FirstName">
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="LastName" class="form-label">Last Name</label>
                                <input type="text" class="form-control" id="LastName" name="LastName">
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="Email" name="Email">
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="PhoneNumber" class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="PhoneNumber" name="PhoneNumber">
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="GradeId" class="form-label">Grade</label>
                                <select class="form-control" id="GradeId" name="GradeId">
                                    <option value="">-- Select Grade --</option>
                                    @foreach (var grade in Model.AvailableGrades)
                                    {
                                        <option value="@grade.GradeId">@grade.GradeName</option>
                                    }
                                </select>
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Student Address Section -->
                    <div class="mb-3">
                        <h6 class="border-bottom pb-2">Address Information</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="City" class="form-label">City</label>
                                    <input type="text" class="form-control" id="City" name="StudentAddress.City">
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="State" class="form-label">State</label>
                                    <input type="text" class="form-control" id="State" name="StudentAddress.State">
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Select Courses</label>
                        <div>
                            @foreach (var course in Model.AvailableCourses)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedCourseIds" value="@course.CourseId"
                                           id="course_@course.CourseId">
                                    <label class="form-check-label" for="course_@course.CourseId">
                                        @course.CourseDisplay
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="submitStudentBtn">Save Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script asp-append-version="true" src="~/js/studentcourse/studentcourse_ajax_validation.js"></script>
    
}