@model MVC_Application.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container">
    <h1>Delete Student</h1>

    <h3>Are you sure you want to delete this student?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Student ID</dt>
            <dd class="col-sm-10">@Model.StudentId</dd>

            <dt class="col-sm-2">Full Name</dt>
            <dd class="col-sm-10">@Model.FullName</dd>

            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@Model.Email</dd>

            <dt class="col-sm-2">Phone Number</dt>
            <dd class="col-sm-10">@Model.PhoneNumber</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="StudentId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>