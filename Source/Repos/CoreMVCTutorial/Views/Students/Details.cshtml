@model CoreMVCTutorial.Models.Students

@{
    ViewData["Title"] = "Student Details";
}

<h2 class="text-center mb-4">Student Details</h2>

<!-- Card showing only three fields -->
<div class="container">
    <div class="card border-primary">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4 font-weight-bold">Full Name:</div>
                <div class="col-md-8"><p class="mb-0">@Model.FullName</p></div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4 font-weight-bold">Date of Birth:</div>
                <div class="col-md-8"><p class="mb-0">@Model.DateOfBirth.ToShortDateString()</p></div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4 font-weight-bold">Branch:</div>
                <div class="col-md-8"><p class="mb-0">@Model.Branch</p></div>
            </div>
        </div>
    </div>
    <div class="text-center mt-4">
        <a asp-action="List" class="btn btn-primary">Back to List</a>
    </div>
</div>