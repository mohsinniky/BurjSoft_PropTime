@model List<CoreMVCTutorial.Models.Teacher>

<table class="table table-bordered mt-4" id="teachersTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>Father Name</th>
            <th>Email</th>
            <th>Course</th>
            <th>Gender</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var teacher in Model)
            {
                <tr>
                    <td>@teacher.FullName</td>
                    <td>@teacher.FatherName</td>
                    <td>@teacher.Email</td>
                    <td>@teacher.Course</td>
                    <td>@teacher.Gender</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No teachers found.</td>
            </tr>
        }
    </tbody>
</table>