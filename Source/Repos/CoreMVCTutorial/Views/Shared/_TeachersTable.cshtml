@model List<CoreMVCTutorial.Models.Teacher>

@if (Model != null && Model.Any())
{
    foreach (var teacher in Model)
    {
        <tr>
            <td>@teacher.FullName</td>
            <td>@teacher.FatherName</td>
            <td>@teacher.Email</td>
            <td>@teacher.Course</td>
            <td>@teacher.Gender</td>
            <td>
                <button class="btn btn-sm btn-warning edit-teacher-btn" data-id="@teacher.TeacherId">Edit</button>
                <button class="btn btn-sm btn-danger delete-teacher-btn" data-id="@teacher.TeacherId">Delete</button>
            </td>
        </tr>
    }
    

}
else
{
    <tr>
        <td colspan="6" class="text-center">No teachers found.</td>
    </tr>
}