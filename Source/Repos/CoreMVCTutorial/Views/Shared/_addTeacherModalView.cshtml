@model CoreMVCTutorial.Models.Teacher

<!-- Modal -->
<div class="modal fade" id="addTeacherModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog  modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Admission Form</h1>
                <button type="button" class="btn-close closeModalButton" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="myForm">
                    <input type="hidden" id="TeacherId" value="@Model.TeacherId" />
                    <div class="row">
                        <div class="mb-3 col-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" id="txtFullName" value="@Model.FullName" />
                            <span id="fullname-error" class="text-danger"></span>
                        </div>
                        <div class="mb-3 col-6">
                            <label asp-for="FatherName" class="form-label"></label>
                            <input asp-for="FatherName" class="form-control" id="txtFatherName" value="@Model.FatherName" />
                            <span id="fathername-error" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" id="txtEmail" value="@Model.Email" />
                            <span id="email-error" class="text-danger"></span>
                        </div>
                        <div class="mb-3 col-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" id="txtDateOfBirth" value="@(Model.DateOfBirth != DateTime.MinValue ? Model.DateOfBirth.ToString("yyyy-MM-dd") : "")" />
                            <span id="dob-error" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" id="txtPhone" value="@Model.Phone" />
                            <span id="phone-error" class="text-danger"></span>
                        </div>
                        <div class="mb-3 col-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control" id="txtPassword" value="@Model.Password" />
                            <span id="password-error" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-6">
                            <label asp-for="Course" class="form-label"></label>
                            <select asp-for="Course" class="form-select" id="course">
                                <option value="">Choose...</option>
                                @foreach (var course in ViewBag.Courses as List<string>)
                                {
                                    if (Model.Course == course)
                                    {
                                        <option value="@course" selected>@course</option>
                                    }
                                    else
                                    {
                                        <option value="@course">@course</option>
                                    }
                                }
                            </select>
                            <span id="course-error" class="text-danger"></span>
                        </div>
                        <div class="mb-3 col-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <div>
                                @foreach (var gender in Enum.GetValues(typeof(CoreMVCTutorial.Models.Gender)))
                                {
                                    <div class="form-check form-check-inline">
                                        @{
                                            var isTermsChecked = Model.Gender == (CoreMVCTutorial.Models.Gender)gender;
                                        }
                                        <input class="form-check-input" type="radio" asp-for="Gender" value="@((int)gender)" id="gender_@gender"
                                               checked="@(isTermsChecked ? "checked" : null)" />
                                        <label class="form-check-label" for="gender_@gender">@gender</label>
                                    </div>
                                }
                            </div>
                            <span id="gender-error" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3" id="txtAddress">@Model.Address</textarea>
                        <span id="address-error" class="text-danger"></span>
                    </div>

                    <!-- Hobbies (multi-checkbox) -->
                    <div class="mb-3">
                        <label class="form-label">Hobbies</label>
                        <div>
                            @foreach (var hobby in ViewBag.Hobbies as List<string>)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="Hobbies" value="@hobby" id="hobby_@hobby"
                                           @(Model.Hobbies != null && Model.Hobbies.Contains(hobby) ? "checked" : "") />
                                    <label class="form-check-label" for="hobby_@hobby">@hobby</label>
                                </div>
                            }
                        </div>
                        <span id="hobbies-error" class="text-danger"></span>
                    </div>

                    <!-- Skills (multi-select) -->
                    <div class="mb-3">
                        <label asp-for="Skills" class="form-label"></label>
                        <select asp-for="Skills" class="form-select" multiple id="skills">
                            @foreach (var skill in ViewBag.Skills as List<string>)
                            {
                                var isSelected = Model.Skills != null && Model.Skills.Contains(skill);
                                <option value="@skill" selected="@(isSelected ? "selected" : null)">
                                    @skill
                                </option>
                            }
                        </select>
                        <span id="skills-error" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            @{
                                var isChecked = Model.TermsAndConditions ? "checked" : null;
                            }
                            <input asp-for="TermsAndConditions" class="form-check-input" id="terms" checked="@isChecked" />
                            <label asp-for="TermsAndConditions" class="form-check-label"></label>
                        </div>
                        <span id="terms-error" class="text-danger"></span>
                    </div>
                    <button type="button" onclick="saveTeacher()" class="btn btn-outline-success" id="addTeacher">
                        Add
                    </button>

                    <button type="button" class="btn btn-success" id="updateTeacher">
                        Update
                    </button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary closeModalButton" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
