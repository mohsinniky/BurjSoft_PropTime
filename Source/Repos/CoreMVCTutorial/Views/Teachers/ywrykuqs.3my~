@model CoreMVCTutorial.Models.Teacher

@{
    ViewData["Title"] = "HomePage";
}

<button type="button" id="modalButton" class="btn btn-outline-primary col-auto">
    Add Teacher
</button>

<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog  modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Admission Form</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Index" asp-controller="Teachers" method="post">

                    <div class="row">
                        <div class="mb-3 col-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                        <div class="mb-3 col-6">
                            <label asp-for="FatherName" class="form-label"></label>
                            <input asp-for="FatherName" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                        <div class="mb-3 col-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                        <div class="mb-3 col-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-6">
                            <label asp-for="Course" class="form-label"></label>
                            <select asp-for="Course" class="form-select">
                                <option value="">Choose...</option>
                                @foreach (var course in ViewBag.Courses as List<string>)
                                {
                                    <option value="@course">@course</option>
                                }
                            </select>
                            <span class="text-danger"></span>
                        </div>
                        <div class="mb-3 col-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <div>
                                @foreach (var gender in Enum.GetValues(typeof(CoreMVCTutorial.Models.Gender)))
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" id="gender_@gender" />
                                        <label class="form-check-label" for="gender_@gender">@gender</label>
                                    </div>
                                }
                            </div>
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <!-- Hobbies (multi-checkbox) -->
                    <div class="mb-3">
                        <label class="form-label">Hobbies</label>
                        <div>
                            @foreach (var hobby in ViewBag.Hobbies as List<string>)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="Hobbies" value="@hobby" id="hobby_@hobby"
                                        @(Model.Hobbies != null && Model.Hobbies.Contains(hobby) ? "checked" : "") />
                                    <label class="form-check-label" for="hobby_@hobby">@hobby</label>
                                </div>
                            }
                        </div>
                        <span class="text-danger"></span>
                    </div>

                    <!-- Skills (multi-select) -->
                    <div class="mb-3">
                        <label asp-for="Skills" class="form-label"></label>
                        <select asp-for="Skills" class="form-select" multiple>
                            @foreach (var skill in ViewBag.Skills as List<string>)
                            {
                                <option value="@skill">@skill</option>
                            }
                        </select>
                        <span class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="TermsAndConditions" class="form-check-input" />
                            <label asp-for="TermsAndConditions" class="form-check-label"></label>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-success" id="add">
                        Add
                    </button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/custom.js"></script>
}