@model CoreMVCTutorial.Models.Teacher

@{
    ViewData["Title"] = "HomePage";
}
<div class="row w-100">
    <button type="button" id="modalButton" class="btn btn-outline-primary mx-2 col-auto">
        Add Teacher
    </button>

    <button type="button" id="getTimeButton" class="btn btn-outline-primary mx-2 col-auto">
        Without Params, GetTime
    </button>

    <button type="button" id="getGreeting" class="btn btn-outline-primary mx-2 col-auto">
        Greetings
    </button>

    <button type="button" id="postMultiply" class="btn btn-outline-primary mx-2 col-auto">
        MultiplyTwoNums
    </button>

    <button type="button" id="postTeacherObject" class="btn btn-outline-primary mx-2 col-auto">
        SendTeacherData
    </button>

    <button type="button" id="postMultipleTeacherData" class="btn btn-outline-primary mx-2 col-auto">
        SendMultipleTeacherData
    </button>

</div>

<h1 id="ajaxResponseSection"></h1>
<div id="modalPlaceholder"></div>

<!-- Table placeholder -->
<div id="teachersTablePlaceholder">
    @Html.Partial("_TeachersTable", ViewBag.Teachers as List<CoreMVCTutorial.Models.Teacher>)
</div>

@section Scripts {
    <script src="~/js/teacherJs/custom.js" asp-append-version="true"></script>
}