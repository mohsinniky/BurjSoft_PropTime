@* @model CoreMVCTutorial.Models.Teacher *@

@{
    ViewData["Title"] = "HomePage";
}
<div class="row w-100">
    <button type="button" id="modalButton" class="btn btn-outline-primary mx-2 col-auto">
        Add Teacher
    </button>
</div>

<h1 id="ajaxResponseSection"></h1>
<div id="modalPlaceholder"></div>

<!-- Table placeholder -->
<div id="teachersTablePlaceholder">
    <table class="table table-bordered mt-4" id="teachersTable">
        <thead>
            <tr>
                <th>Name</th>
                <th>Father Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Gender</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="teachersList">
            
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/teacherJs/custom.js" asp-append-version="true"></script>
}